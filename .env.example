# Opcional. URL del backend (carpeta server/).
# Si lo dejas vacío, la app usa automáticamente la IP de tu PC (la misma que usa Expo) y el puerto 3001.
# Rellénalo solo si usas un túnel o el servidor está en otra máquina, p. ej.:
# EXPO_PUBLIC_API_URL=http://192.168.1.42:3001
EXPO_PUBLIC_API_URL=

# Firebase Authentication (login, registro y verificación por correo).
# Consola de Firebase → Configuración del proyecto → Tus apps → app Web → firebaseConfig.
# Estos valores no son secretos: identifican el proyecto y van dentro de la app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
