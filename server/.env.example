# Copia este archivo como server/.env y rellena tu clave.
# Obtén una API key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de Gemini. Para ver los disponibles para tu clave: npm run models (desde server/)
GEMINI_MODEL=gemini-3.5-flash
# Modelo de respaldo si el principal está saturado (déjalo vacío para desactivarlo)
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Puerto del servidor (la app lo busca por defecto en el 3001)
PORT=3001
