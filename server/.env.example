# Copia este archivo como server/.env y rellena tu clave.
# Obtén una API key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de Gemini. Para ver los disponibles para tu clave: npm run models (desde server/)
GEMINI_MODEL=gemini-3.5-flash
# Modelo de respaldo si el principal está saturado (déjalo vacío para desactivarlo)
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# ID del proyecto de Firebase (el mismo que EXPO_PUBLIC_FIREBASE_PROJECT_ID de la app).
# Si está definido, el servidor solo atiende a usuarios con sesión iniciada y el correo verificado.
# Si lo dejas vacío, el servidor funciona sin login (útil para pruebas locales).
FIREBASE_PROJECT_ID=

# Puerto del servidor (la app lo busca por defecto en el 3001)
PORT=3001
